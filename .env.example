# Copie para .env.local e preencha. Nunca faça commit do .env.local.

# ---- Supabase (Settings → API) ----
# Pode ir para o navegador: endereço do projeto e chave publicável (sb_publishable_…).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SEGREDO. Só no servidor: usada pelo sync automático (cron) e pelo acesso do Claude (MCP).
# Nunca coloque o prefixo NEXT_PUBLIC_ nela.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Pluggy (dashboard.pluggy.ai → Applications) ----
# SEGREDOS. Só no servidor; o navegador nunca fala com a Pluggy.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# ---- Sync automático ----
# SEGREDO. Qualquer texto longo e aleatório, ex.: `openssl rand -hex 32`.
# A Vercel manda esse valor ao chamar /api/cron/sync; o workflow do GitHub também.
CRON_SECRET=

# ---- Opcional ----
# IP do seu computador na rede, para abrir o `npm run dev` pelo celular (separe vários por vírgula).
DEV_ORIGINS=
